SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
DASHBOARD_PASSWORD=your_secure_password
PORT=3000

# Optional server-side marketing integrations. Load from Doppler dreamcatcher/prd.
# Never put these keys in public/ or client JavaScript.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=452799
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=projb2ec85a8
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Self-hosted Umami: dedicated view-only DreamCatcher account, stored in Doppler.
UMAMI_URL=https://analytics.dissonance.cloud
UMAMI_WEBSITE_ID=3a631133-dde5-406e-8bfb-8fa32b7a7afc
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_COLLECTION_START=2026-09-13T19:32:01.000Z

# AppsFlyer aggregate reporting only. Never expose the reporting token to browsers.
APPSFLYER_API_TOKEN=
# Pause provider calls when the trial expires; only extend after access/cost confirmation.
APPSFLYER_API_ACCESS_UNTIL=2026-10-12

# Store reports: existing DreamCatcher credentials from Doppler.
ASC_KEY_BASE64=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_APP_ID=6762375451
ASC_ANALYTICS_REQUEST_ID=
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY_BASE64=
GOOGLE_PLAY_REPORT_BUCKET=pubsite_prod_6331983831194272993
# Private persistent mount; never place under public/. Postiz owns OAuth refresh.
REPORTING_DATA_DIR=/app/data
POSTIZ_INSIGHTS_FILE=/app/data/postiz-instagram.json
